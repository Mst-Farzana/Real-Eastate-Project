# ==========================================
# DEPENDENCIES
# ==========================================
/frontend/node_modules
/backend/node_modules
/backend/vendor/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ==========================================
# ENVIRONMENT & SECRETS (সবচেয়ে গুরুত্বপূর্ণ)
# ==========================================
/frontend/.env*
/backend/.env
/backend/.env.backup
/backend/.env.production
/backend/*.log

# ==========================================
# NEXT.JS (Frontend)
# ==========================================
/frontend/.next/
/frontend/out/
/frontend/build
/frontend/.vercel

# ==========================================
# LARAVEL (Backend)
# ==========================================
/backend/public/storage
/backend/storage/*.key
/backend/storage/logs/laravel.log
/backend/.phpunit.result.cache
/backend/Homestead.json
/backend/Homestead.yaml
/backend/.phpactor.json

# ==========================================
# TESTING & DEBUGGING
# ==========================================
/coverage
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================
# MISC & OS FILES
# ==========================================
.DS_Store
*.pem
*.swp
*.swo
*~
Thumbs.db

# ==========================================
# TYPESCRIPT
# ==========================================
*.tsbuildinfo
next-env.d.ts
.npmrc
!/frontend/.npmrc